# ASTRA Pilot — Environment Configuration
# =========================================
# Copy this file to infra/astra.env and fill in the values marked REQUIRED.
# This file is loaded by docker-compose.pilot.yml.
# NEVER commit astra.env to git — it contains secrets.
#
# Service-to-service connection strings (Redis, Kafka, DB, etc.) are set
# directly in docker-compose.pilot.yml using Docker service names.
# Only bank-specific secrets live here.

# ── Identity (REQUIRED) ───────────────────────────────────────────────────────

BANK_ID=your-bank-id-here           # e.g. saraswat-coop
ASTRA_ENV=production
ASTRA_SECRETS_BACKEND=env
ENV=production

# ── Session signing keys (REQUIRED) ───────────────────────────────────────────
# Generate on any machine with Python: python scripts/dev-init.py --bank-id <id>
# Then copy the contents of secrets/session.priv.pem and secrets/session.pub.pem here.
# Keep line breaks — PEM format requires them.

ASTRA_SECRET_AUTH_SESSION_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----
# paste your private key lines here
-----END PRIVATE KEY-----

ASTRA_SECRET_AUTH_SESSION_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----
# paste your public key lines here
-----END PUBLIC KEY-----

# ── PII protection (REQUIRED — change from any dev value before handling real data) ──
# Random secret string, min 32 characters. Used as HMAC pepper for account number hashing.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"

ASTRA_SECRET_BANKS_YOUR_BANK_PII_HASH_PEPPER=CHANGE-THIS-TO-A-RANDOM-64-CHAR-SECRET

# ── MinIO object store credentials ───────────────────────────────────────────
ASTRA_SECRET_MINIO_ACCESS_KEY=astra-pilot
MINIO_SECRET_KEY=CHANGE-THIS-MINIO-PASSWORD

# ── ImmuDB (audit trail) ─────────────────────────────────────────────────────
ASTRA_SECRET_IMMUDB_ADMIN_PASSWORD=CHANGE-THIS-IMMUDB-PASSWORD

# ── NGCH (deferred for POC — leave as placeholder) ───────────────────────────
ASTRA_SECRET_NGCH_API_KEY=pilot-placeholder
ASTRA_SECRET_NGCH_SFTP_PRIVATE_KEY=

# ── CBS connectors (fill in when CBS wiring is implemented) ──────────────────
ASTRA_SECRET_CBS_FINACLE_PASSWORD=
ASTRA_SECRET_CBS_BANCS_PASSWORD=
ASTRA_SECRET_CBS_FLEXCUBE_PASSWORD=

# ── AI Inference (HuggingFace endpoint for POC) ──────────────────────────────
# Set when HuggingFace inference endpoint is ready
ASTRA_SECRET_HUGGINGFACE_API_KEY=
